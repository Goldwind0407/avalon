# Copy to /etc/turnserver.conf on a Linux host running coturn.
# Replace the realm, external address and secret BEFORE starting the service.
listening-port=3478
min-port=49160
max-port=49259
realm=voice.example.com
# A host behind NAT needs PUBLIC_IP/PRIVATE_IP here and matching port forwards.
# A host with its public IP directly on its interface can omit external-ip.
# external-ip=203.0.113.10/10.0.0.10
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Several transports/candidates can allocate per peer; allow a 10-player mesh.
user-quota=40
total-quota=400
no-cli
no-multicast-peers
no-tls
no-dtls
# Keep private/local services inaccessible through the relay.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=224.0.0.0-255.255.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
