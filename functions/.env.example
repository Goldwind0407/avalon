# Optional: leave both empty for STUN-only peer-to-peer voice.
# The app must also be built with --dart-define=VOICE_ENABLE_TURN=true.
# Copy into .env.avalon-shadow-council (ignored by git), never into Flutter.
VOICE_TURN_URLS=
# Same random secret as coturn's static-auth-secret. Never commit a real value.
VOICE_TURN_SECRET=
